# Let the `input` group open /dev/uinput, so that `tobii-gaze-keys` can inject
# Left/Right arrow keys without sudo. By default /dev/uinput is root-only
# (crw-------). The binder also reads the keyboards (/dev/input/event*, which
# the group may read) to see Super held, so its user joins the group anyway.
#
# A group, not the "uaccess" tag the tracker's rule sets: the tag would let
# whatever the user at the seat runs inject keystrokes, and still not let the
# binder read the keyboards.
#
# Install:  sudo cp 70-tobii-uinput.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger /dev/uinput
#           sudo usermod -aG input $USER     # then re-login for the group to apply
#
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
