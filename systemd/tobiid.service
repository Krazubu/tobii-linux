[Unit]
Description=Tobii Eye Tracker 5 daemon (head/gaze/presence broker)
Documentation=https://github.com/Skyggedans/tobii-linux
# No After=default.target: the clients' units, which default.target wants and
# so starts after, order themselves after this one, and the three made a
# cycle that systemd broke at login by dropping a client. XDG_RUNTIME_DIR
# exists before the user manager starts any unit.

[Service]
Type=simple
# Dev build path; change to /usr/local/bin/tobiid once installed.
ExecStart=%h/Work/tobii/target/release/tobiid
Restart=on-failure
RestartSec=2
# The daemon claims the USB device; keep it lean.
Nice=-5
# Keep the device warm so client connects are instant (the IR illuminator stays
# on while the service runs):
#Environment=TOBII_PREWARM=1
# Skip the USB reset the engine tries once opens keep failing (it rarely helps
# now that uvcvideo is kept off the device):
#Environment=TOBII_NO_RESET=1

[Install]
WantedBy=default.target
